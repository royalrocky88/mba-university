# Copy this file to `.env.local` and fill in your Supabase project values.
#
# Where to find them:
#   Supabase Dashboard → your project → Settings → API
#
# Leave both blank (or delete .env.local) to run the site on bundled seed
# content — every page still renders, but the admin panel is read-only.
#
# The anon key is safe to ship in a browser bundle: row-level security in
# supabase/schema.sql is what actually gates writes, not this key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
